<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet access -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Network state -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wallpaper permissions -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Required to set system ringtone -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Legacy storage support for older Android versions -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EmaanWallpapers"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        tools:replace="android:theme">

        <!-- ========================= -->
        <!-- Meta / Facebook SDK -->
        <!-- ========================= -->

        <!-- Meta App ID -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />

        <!-- Meta Client Token -->
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />

        <!-- ========================= -->
        <!-- Mixpanel -->
        <!-- ========================= -->

        <!-- Enable Mixpanel debug logs -->
        <!-- Set to false in production release -->
        <meta-data
            android:name="com.mixpanel.android.MPConfig.EnableDebugLogging"
            android:value="false" />

        <!-- ========================= -->
        <!-- Main Activity -->
        <!-- ========================= -->

        <!-- singleTop ensures Razorpay/UPI returns to same activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EmaanWallpapers">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- ========================= -->
        <!-- Razorpay -->
        <!-- ========================= -->

        <!-- Razorpay checkout activity -->
        <activity
            android:name="com.razorpay.CheckoutActivity"
            android:theme="@style/Theme.RazorpayCheckout"
            tools:replace="android:theme" />

        <!-- ========================= -->
        <!-- Live Wallpaper Service -->
        <!-- ========================= -->

        <service
            android:name=".service.GifWallpaperService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">

            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>

            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_info" />

        </service>

        <!-- ========================= -->
        <!-- Wallpaper Preview -->
        <!-- ========================= -->

        <activity
            android:name=".ui.wallpaper.WallpaperPreviewActivity"
            android:exported="false" />

        <!-- ========================= -->
        <!-- File Provider -->
        <!-- ========================= -->

        <!-- Used for sharing videos/files securely -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.file_provider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>

    </application>

</manifest>